{
  "name": "@integraledger/agentic-terms-root",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "audit": "pnpm audit --audit-level moderate",
    "build": "pnpm -r build",
    "check:docs": "node scripts/check-doc-snippets.mjs",
    "check:commit-messages": "node scripts/check-commit-messages.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:runtime": "node scripts/runtime-consumer.mjs && node .runtime-consumer/runtime-smoke.mjs",
    "check:vocab": "node scripts/check-vocab.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:wire": "node scripts/check-wire-identities.mjs",
    "docs:build": "npm --prefix website run build",
    "docs:dev": "npm --prefix website run dev",
    "lint": "biome check .",
    "mutation": "node scripts/mutation.mjs",
    "mutation:all": "node scripts/mutation.mjs",
    "release:approve": "node scripts/approve-staged.mjs",
    "seal:wire": "node scripts/check-wire-identities.mjs --write",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm check:versions && pnpm check:commit-messages && pnpm check:wire && pnpm check:public-boundary && pnpm check:vocab && pnpm audit --audit-level moderate && pnpm -r build && pnpm lint && pnpm -r typecheck && pnpm check:docs && pnpm -r test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@integraledger/agentic-terms": "workspace:*",
    "@integraledger/lcp-conformance": "0.14.0",
    "@integraledger/lcp-mcp-server": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "catalog:",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}
