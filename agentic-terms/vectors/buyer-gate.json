  "parse": {
    "about": "The parse refuses exactly what lcp's assemble refuses in a party's bytes, its check 8 (core/content-not-json). lcp's core-vectors.json rows are the parse's rows too: refusals V5b (two JSON values) and V5c (bytes not UTF-8), refused, and jsonDepth's rows, accepted where accept is true. These rows are the cases that file does not hold, each a specification's own example: RFC 7493 section 2.2's integer and its range, read with Python's int, and its 1E400; RFC 8259 section 6's NaN and Infinity; RFC 8259 section 8.3's two spellings of one name; and RFC 8259 section 8.1's byte-order mark. hex is the text's bytes; accept says whether the parse takes it.",
    "rows": [
      {
        "name": "JP1",
        "case": "9007199254740991, RFC 7493 section 2.2's largest exact integer",
        "hex": "39303037313939323534373430393931",
        "accept": true
      },
      {
        "name": "JP2",
        "case": "2^53, past the range RFC 7493 section 2.2 gives, [-(2**53)+1, (2**53)-1]",
        "hex": "39303037313939323534373430393932",
        "accept": false
      },
      {
        "name": "JP3",
        "case": "-(2^53), past that range",
        "hex": "2d39303037313939323534373430393932",
        "accept": false
      },
      {
        "name": "JP4",
        "case": "1E400, RFC 7493 section 2.2's example of a number past a double's magnitude",
        "hex": "3145343030",
        "accept": false
      },
      {
        "name": "JP5",
        "case": "NaN, which RFC 8259 section 6 does not permit",
        "hex": "4e614e",
        "accept": false
      },
      {
        "name": "JP6",
        "case": "Infinity, which RFC 8259 section 6 does not permit",
        "hex": "496e66696e697479",
        "accept": false
      },
      {
        "name": "JP7",
        "case": "an object holding the two names of RFC 8259 section 8.3's example, \"a\\\\b\" and \"a\\u005Cb\", one name once its escapes are decoded (RFC 7493 section 2.3)",
        "hex": "7b22615c5c62223a312c22615c753030354362223a327d",
        "accept": false
      },
      {
        "name": "JP8",
        "case": "JP1 after a byte-order mark, U+FEFF in UTF-8, which RFC 8259 section 8.1 forbids a sender to add",
        "hex": "efbbbf39303037313939323534373430393931",
        "accept": false
      }
    ]
  }
