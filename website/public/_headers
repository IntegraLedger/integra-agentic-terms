# Security and caching headers for every response served by this Pages project.
# One in-repo source of truth. functions/_middleware.ts re-emits HSTS on its 301 so
# the redirect itself carries it; measured on the LCP site, which uses the same pair,
# these rules apply to responses passed through that function too.
#
# The site loads nothing from any other origin — fonts ship with the export — so the
# policy is 'self'. Inline scripts and styles are Next's own bootstrap and the theme
# initializer; the search index is fetched from /api/search on this origin.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# Content-hashed build assets are immutable — cache them hard for repeat visits.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Next emits the generated images and the search index as extensionless files;
# pin their types so social scrapers and the search client receive the real thing.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/apple-icon
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/api/search
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Machine-readable copies of the documentation.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/md/*
  Content-Type: text/markdown; charset=utf-8
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
